# Copy jadi .env lalu isi. JANGAN commit file .env.
JIRA_BASE_URL=https://namaperusahaan.atlassian.net
JIRA_EMAIL=bens.sky69@gmail.com

# Bikin di https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# JQL penentu sub-task mana yang boleh di-done otomatis.
# Contoh aman: dibatasi parent tertentu + label penanda.
JIRA_JQL=assignee = currentUser() AND issuetype = Sub-task AND statusCategory != Done AND parent = ABC-123 ORDER BY created ASC

# Urutan status menuju selesai, dipisah koma. Banyak workflow gak boleh lompat
# langsung ke DONE. Contoh ATIDIS26: Start -> in progress -> DONE
JIRA_STATUS_PATH=in progress, DONE

# Sebagian workflow punya validator "Due date is required" saat transisi.
# "today" = isi tanggal hari ini kalau masih kosong. Kosongkan buat matikan.
JIRA_DUE_DATE=today

# Opsional, komentar yang ditempel saat nge-done. Kosongin kalau gak perlu.
JIRA_COMMENT=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Wajib diisi. Kalau kosong, semua pesan ditolak.
TELEGRAM_ALLOWED_CHAT_ID=

TZ=Asia/Jakarta
